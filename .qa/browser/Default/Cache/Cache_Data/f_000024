function setRouteMode(mode) { selectWalkMode(mode === 'recommended' ? 'full' : mode === 'auto' ? 'nearby' : mode); }

function addSegment(start, end, isNet, trackState) {
    if (!start || !end) return 0;
    
    let finalOpacity = trackState === 'faded' ? 0.15 : 0.95;
    let finalWeight = trackState === 'faded' ? (isNet ? 1.6 : 1.2) : (isNet ? 3.2 : 1.6);

    const sf = isNet ? { color:document.body.classList.contains('outdoor') ? '#b4132c' : '#ff6279', weight:2.4, opacity:.045, interactive:false } : { color:'#fff', weight:1.2, opacity:.06, dashArray:'3,6', interactive:false };
    const sa = isNet ? { color:document.body.classList.contains('outdoor') ? '#b4132c' : '#ff6279', weight:finalWeight, opacity:finalOpacity, lineCap:'round', interactive:false } : { color:document.body.classList.contains('outdoor') ? '#812342' : '#ffb1bd', weight:finalWeight, opacity:finalOpacity, dashArray:'4,6', interactive:false };
                     
    L.polyline([start, end], sf).addTo(routeGroupFull);
    L.polyline([start, end], sa).addTo(routeGroupRemaining);
    
    if (isNet && Array.isArray(start[0])) {
        let d = 0; for (let i = 0; i < start.length - 1; i++) d += getDistance(start[i][0], start[i][1], start[i+1][0], start[i+1][1]);
        return d;
    }
    return getDistance(start[0], start[1], end[0], end[1]);
}

function getRoutePointKey(point) {
    return `${Number(point[0]).toFixed(6)},${Number(point[1]).toFixed(6)}`;
}

function getRouteSegmentKey(a, b) {
    const ak = getRoutePointKey(a), bk = getRoutePointKey(b);
    return ak < bk ? `${ak}|${bk}` : `${bk}|${ak}`;
}

function addPathToRepeatCounts(path, counts, coordsByKey) {
    if (!Array.isArray(path) || path.length < 2) return;
    for (let i = 0; i < path.length - 1; i++) {
        const a = path[i], b = path[i + 1];
        if (!Array.isArray(a) || !Array.isArray(b)) continue;
        const key = getRouteSegmentKey(a, b);
        counts.set(key, (counts.get(key) || 0) + 1);
        if (!coordsByKey.has(key)) coordsByKey.set(key, [a, b]);
    }
}

function buildRepeatPathData(nextIdx) {
    const counts = new Map();
    const coordsByKey = new Map();
    const startIndex = userLoc ? Math.max(0, nextIdx) : 0;

    if (userLoc && currentRoute[startIndex]) {
        const sk = snapToNetwork(userLoc.lat, userLoc.lng);
        const ek = getTreeSnapKey(currentRoute[startIndex]);
        const np = sk && ek ? findNetworkPath(sk, ek) : null;
        if (np) addPathToRepeatCounts(np, counts, coordsByKey);
    }

    for (let i = startIndex; i < currentRoute.length - 1; i++) {
        const sk = getTreeSnapKey(currentRoute[i]);
        const ek = getTreeSnapKey(currentRoute[i + 1]);
        const np = sk && ek ? findNetworkPath(sk, ek) : null;
        if (np) addPathToRepeatCounts(np, counts, coordsByKey);
    }

    return { counts, coordsByKey };
}

function drawRepeatPathHighlights(repeatData) {
