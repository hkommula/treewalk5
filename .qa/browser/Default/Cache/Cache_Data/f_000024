// ── 5. LIVE PROXIMITY TOOLTIPS & DISTANCES ─────────────────
function getBearingDegrees(from, to) {
    const lat1 = from.lat * DEG, lat2 = to.lat * DEG;
    const deltaLng = (to.lng - from.lng) * DEG;
    const y = Math.sin(deltaLng) * Math.cos(lat2);
    const x = Math.cos(lat1) * Math.sin(lat2) - Math.sin(lat1) * Math.cos(lat2) * Math.cos(deltaLng);
    return (Math.atan2(y, x) / DEG + 360) % 360;
}

function getNearbyLabelSize(label) {
    const textWidth = Math.min(180, Math.max(72, label.length * 6.2 + 18));
    return { width: textWidth, height: 28 };
}

function getRectForLabel(anchor, layout, size) {
    const x = anchor.x + layout.offset[0];
    const y = anchor.y + layout.offset[1];
    if (layout.direction === 'top') return { left: x - size.width / 2, right: x + size.width / 2, top: y - size.height, bottom: y };
    if (layout.direction === 'bottom') return { left: x - size.width / 2, right: x + size.width / 2, top: y, bottom: y + size.height };
    if (layout.direction === 'right') return { left: x, right: x + size.width, top: y - size.height / 2, bottom: y + size.height / 2 };
    return { left: x - size.width, right: x, top: y - size.height / 2, bottom: y + size.height / 2 };
}

function rectsOverlap(a, b, gap = 8) {
    return !(a.right + gap < b.left || a.left - gap > b.right || a.bottom + gap < b.top || a.top - gap > b.bottom);
}

function rectFitsViewport(rect) {
    const pad = 8;
    const size = map.getSize();
    return rect.left >= pad && rect.top >= pad && rect.right <= size.x - pad && rect.bottom <= size.y - pad;
}

function getNearbyLabelCandidates(tree) {
    const bearing = getBearingDegrees(userLoc, tree);
    const base = [
        { direction: 'top', offset: [0, -14], angle: 0 },
        { direction: 'right', offset: [14, -12], angle: 45 },
        { direction: 'right', offset: [16, 0], angle: 90 },
        { direction: 'right', offset: [14, 12], angle: 135 },
        { direction: 'bottom', offset: [0, 14], angle: 180 },
        { direction: 'left', offset: [-14, 12], angle: 225 },
        { direction: 'left', offset: [-16, 0], angle: 270 },
        { direction: 'left', offset: [-14, -12], angle: 315 }
    ];

    return base
        .map(layout => {
            const delta = Math.abs(((bearing - layout.angle + 540) % 360) - 180);
            return { ...layout, score: delta };
        })
        .sort((a, b) => a.score - b.score);
}

function getNearbyLabelLayout(tree, label, reservedRects) {
    const anchor = map.latLngToLayerPoint([tree.lat, tree.lng]);
    const size = getNearbyLabelSize(label);
    const candidates = getNearbyLabelCandidates(tree);

    for (const candidate of candidates) {
        const rect = getRectForLabel(anchor, candidate, size);
        if (!rectFitsViewport(rect)) continue;
        if (reservedRects.some(existing => rectsOverlap(rect, existing))) continue;
        reservedRects.push(rect);
        return candidate;
    }

    for (const candidate of candidates) {
        const rect = getRectForLabel(anchor, candidate, size);
        if (reservedRects.some(existing => rectsOverlap(rect, existing, 3))) continue;
        reservedRects.push(rect);
        return candidate;
    }

    const fallback = candidates[0];
    reservedRects.push(getRectForLabel(anchor, fallback, size));
    return fallback;
}

function triggerNearbyHaptic(distance) {
    if (!customSettings.haptics || typeof navigator === 'undefined' || typeof navigator.vibrate !== 'function') return;
    const now = Date.now();
    if (now - lastHapticAt < 7000) return;
    lastHapticAt = now;
    navigator.vibrate(distance <= 10 ? [35, 45, 35] : 28);
}

function updateHapticProximity(proximityItems) {
    if (!customSettings.haptics) return;
    proximityItems.forEach(({ tree, distance }) => {
        if (distance > 25) hapticAlertedTreeIds.delete(tree.id);
    });

    const nearest = proximityItems
        .filter(item => item.distance <= 20 && !hapticAlertedTreeIds.has(item.tree.id))
        .sort((a, b) => a.distance - b.distance)[0];

    if (!nearest) return;
    hapticAlertedTreeIds.add(nearest.tree.id);
    triggerNearbyHaptic(nearest.distance);
}

function updateDynamicGPSContexts() {
    if (!userLoc) return;
    const nextNearbyIds = new Set();
    const reservedLabelRects = [];
    const proximityItems = treeData.map(t => ({
        tree: t,
        distance: getDistance(userLoc.lat, userLoc.lng, t.lat, t.lng),
        marker: markersMap[t.id]
    }));
    if(walk.status !== 'active' && userLoc.accuracy <= 35) updateHapticProximity(proximityItems);

    if (!customSettings.nearbyLabels) {
        clearNearbyTooltips();
        if (activeTreeId && activeTree) updateDetailMiniCoords(activeTree);
        return;
    }

    const nearbyTrees = proximityItems
        .filter(item => item.marker && item.distance <= NEARBY_LABEL_DISTANCE)
        .sort((a, b) => a.distance - b.distance)
        .slice(0, NEARBY_LABEL_LIMIT);

    nearbyTrees.forEach(({ tree, distance, marker }) => {
        const label = `${tree.name} - ${Math.round(distance)}m`;
        const layout = getNearbyLabelLayout(tree, label, reservedLabelRects);
        const layoutKey = `${label}|${layout.direction}|${layout.offset.join(',')}`;
        nextNearbyIds.add(tree.id);

        if (nearbyTooltipLayoutKeys.get(tree.id) !== layoutKey) {
            marker.unbindTooltip();
            marker.bindTooltip(label, {
                permanent: true,
                direction: layout.direction,
                className: 'nearby-tree-label',
                offset: layout.offset,
                opacity: 0.95
            }).openTooltip();
            nearbyTooltipLayoutKeys.set(tree.id, layoutKey);
        }
    });
    nearbyTooltipIds.forEach(id => {
        if (nextNearbyIds.has(id)) return;
        const marker = markersMap[id];
        if (marker) marker.unbindTooltip();
        nearbyTooltipLayoutKeys.delete(id);
    });
    nearbyTooltipIds.clear();
    nextNearbyIds.forEach(id => nearbyTooltipIds.add(id));

    if (activeTreeId && activeTree) updateDetailMiniCoords(activeTree);
}

// ── 6. PANEL VIEW LOGIC ─────────────────────────────────────
const stopsList = document.getElementById('stops-list');
const detailViewArea = document.getElementById('tree-detail-view');
const detailContentArea = document.getElementById('detail-content-area');
const detailMiniCoords = document.getElementById('detail-mini-coords');

function updateDetailMiniCoords(tree) {
    if (!detailMiniCoords || !tree) return;
    const leg = walkingLeg(walkOrigin(),tree);
    detailMiniCoords.textContent = `${formatDistance(leg.distance)} ${leg.network ? 'via paths' : 'direct estimate'} ? from ${originDescription()}`;
}
function fitDetailSheetToContent() { if(isSheetLayout())setSheetState('expanded'); }
function expandDetailSheetForImage() { }

function openAboutModal() {
    const modal = document.getElementById('about-modal');
    const body = document.getElementById('welcome-content');
    if (body && welcomeHTML) body.innerHTML = welcomeHTML;
    dialogReturnFocus = document.activeElement;
    modal?.classList.add('show');
    document.getElementById('about-modal-close')?.focus();
}

function closeAboutModal() {
    try { localStorage.setItem(WELCOME_SEEN_KEY, 'true'); } catch (e) {}
    const wasOpen = document.getElementById('about-modal')?.classList.contains('show');
    document.getElementById('about-modal')?.classList.remove('show');
    if(wasOpen)dialogReturnFocus?.focus();
}

function syncCardVisitedState(id) { renderSidebar(); }

function updateDetailVisitButton(id) {
    const btn = document.getElementById(`bv-${id}`);
    if (!btn) return;
    const isVisited = visitedStops.has(id);
    btn.className = isVisited ? 'pb pb-unvisit' : 'pb pb-visit';
    btn.innerHTML = isVisited
        ? `<i class="bi bi-arrow-counterclockwise" style="margin-right:4px"></i>Mark unvisited`
        : `<i class="bi bi-check2-circle" style="margin-right:4px"></i>Mark visited`;
}

function renderSidebar() { renderTreeCards(); updateProgress(); }

stopsList.addEventListener('click', event => {
    const card = event.target.closest('.tree-card');
    if (!card) return;
    const id = Number(card.dataset.treeId);
    const tree = treeById.get(id);
    if (!tree) return;
    activateTree(id);
    flyToVisible([tree.lat, tree.lng], 19, {animate: motionOK(), duration: 0.4});
});

function activateTree(id, options = {}) {
    if(!options.walking){
        walk.follow=false;
        if(walkView!=='detail')detailReturnView=walkView==='browse'?'browse':walk.status==='active'?'walking':'home';
    }
    walkView=options.walking?'walking':'detail';
    applyWalkView();
    updateNavigation();
    const prevActiveId = activeTreeId;
    activeTreeId = id;
    activeTree = treeById.get(id) || null;
    
    if (prevActiveId) updateMarkerStyle(prevActiveId);
    if (activeTreeId) updateMarkerStyle(activeTreeId);

    // Swap Panel Views

    
    const tree = activeTree;
    if (tree) {
        updateDetailMiniCoords(tree);
        detailContentArea.innerHTML = getDetailsHTML(tree);
        
        // Setup Visit Toggle Button
        const btn = document.getElementById(`bv-${id}`);
        if (btn) {
            btn.onclick = (e) => {
                e.stopPropagation();
                toggleVisited(id);
                updateDetailVisitButton(id);
            };
        }
        
        updateDetailVisitButton(id);
        if(!options.passive){
            const heading=detailContentArea.querySelector('h2');heading?.setAttribute('tabindex','-1');heading?.focus({preventScroll:true});
            document.querySelector('.panel-body').scrollTop=0;
            fitDetailSheetToContent();
        }
    }
}

window.backToList = () => {
    const destination=walkView==='detail'?detailReturnView:walk.status==='active'?'walking':'home';
    if(destination==='walking'){
        walkView='walking';renderWalkingDetails();setWalkView('walking');
        if(isSheetLayout())setSheetState('peek');
    }else{
        const previous=activeTreeId;activeTreeId=null;activeTree=null;
        if(previous)updateMarkerStyle(previous);
        if(destination==='browse')showBrowser();else showHome();
    }
};

function isFeaturelessMapClick(event) {
    const target = event.originalEvent?.target;
    if (!target || !map.getContainer().contains(target)) return false;
    return !target.closest?.('#ui-panel,.map-controls,.leaflet-control,.leaflet-marker-icon,.leaflet-tooltip,.leaflet-interactive');
}

map.on('click', event => {
    if (!isFeaturelessMapClick(event)) return;
    const customPanel = document.getElementById('custom-panel');
    if (customPanel?.classList.contains('show')) {
        customPanel.classList.remove('show');
        syncCustomSettingsUI();
    }
    if (activeTreeId || detailViewArea.style.display === 'block') backToList();
});

// ── 7. LIGHTBOX ──────────────────────────────────────────────
window.openLightbox = async src => {
    expandDetailSheetForImage();
    const lb = document.getElementById('lightbox');
    dialogReturnFocus = document.activeElement;
    document.getElementById('lightbox-img').alt = activeTree ? activeTree.name : 'Tree photograph';
    document.getElementById('lightbox-img').onerror = () => showStatus('Full-size photo unavailable. The smaller detail photo is still available.');
    document.getElementById('lightbox-img').src = await getOptimizedImageSrc(src);
    lb.style.display = 'flex'; lb.querySelector('button').focus(); requestAnimationFrame(() => lb.style.opacity = '1');
};
window.closeLightbox = () => {
    const lb = document.getElementById('lightbox');
    if(lb.style.display==='flex')dialogReturnFocus?.focus();
    lb.style.opacity = '0'; setTimeout(() => lb.style.display = 'none', 250);
};

// ── 8. LEAFLET SIMPLE LOCATE INTEGRATION ──────────────────────
let simpleLocate = null;
const gpsButton = document.getElementById('gps-toggle');

// Helper functions
function clearNearbyTooltips() {
    nearbyTooltipIds.forEach(id => {
        const marker = markersMap[id];
        if (marker) marker.unbindTooltip();
    });
    nearbyTooltipIds.clear();
    nearbyTooltipLayoutKeys.clear();
}

function scheduleGPSRefresh(forceRouteRefresh = false) {
    if (forceRouteRefresh) lastUserRouteRenderLoc = null;
    if (gpsUpdateQueued) return;
    gpsUpdateQueued = true;
    requestAnimationFrame(() => {
        gpsUpdateQueued = false;
        updateDynamicGPSContexts();
        maybeRefreshWalkingRoute(forceRouteRefresh);
    });
}

function resetGPSContext() {
    userLoc = null;
    const originSelect=document.getElementById('walk-start');
    const gpsOption=originSelect.querySelector('[value="gps"]');
    if(gpsOption){gpsOption.disabled=true;gpsOption.textContent='Current location - enable GPS';if(originSelect.value==='gps')originSelect.value=String(walk.startId);}
    if(typeof walk !== 'undefined') { walk.follow = false; updateNavigation(); }
    if (activeTree) updateDetailMiniCoords(activeTree);
    lastUserRouteRenderLoc = null;
    clearNearbyTooltips();
    generateSmartRoutes({ force: true });
}

simpleLocate = new SimpleLocate({
    button: gpsButton,
    geofenceCenter: UOW_CENTER,
    geofenceRadius: 2000,
    highAccuracy: true,
    timeout: 15000,
    maximumAge: 5000,
    onLocationFound: (location) => {
        const isFirstFix = !userLoc;
        userLoc = {
            lat: location.lat,
            lng: location.lng,
            accuracy: location.accuracy,
            heading: location.heading,
            timestamp: location.timestamp
        };

        handleWalkingLocation({...userLoc,timestamp:location.timestamp},isFirstFix);
        scheduleGPSRefresh();
    },
    onLocationError: (error) => {
        resetGPSContext();
        if (error?.type === 'stopped') return;
        showStatus(error?.code === 1 ? 'Location permission denied. Choose a starting tree to walk without GPS.' : 'GPS unavailable. Choose a starting tree or try the location button again.');
    },
    onGeofenceViolation: () => {
        showStatus('You are outside campus. Choose a starting tree to preview your walk.');
    }
}).attachTo(map);

bindCustomSettings();
loadBuildings();
loadWelcomeContent();

document.getElementById('about-modal-close')?.addEventListener('click', closeAboutModal);
document.getElementById('about-modal')?.addEventListener('click', event => {
    if (event.target.id === 'about-modal') closeAboutModal();
});
document.addEventListener('keydown', event => {
    if (event.key === 'Escape') closeAboutModal();
});

document.getElementById('home-view').addEventListener('click', () => {
    fitHomeView({animate: motionOK(), duration: 0.4, maxZoom: 18});
});

document.getElementById('satellite-toggle').addEventListener('click', function() {
    if (map.hasLayer(esriSatellite)) { map.removeLayer(esriSatellite); this.classList.remove('active'); } 
    else { map.addLayer(esriSatellite); this.classList.add('active'); }
});
